<%- include("../partials/head") %>
<%- include("../partials/header") %>
<%- include("../partials/navigation") %>

<main>
  <h1><%= title %></h1>

  <% if (messages && messages.notice && messages.notice.length) { %>
    <div class="notice"><%= messages.notice %></div>
  <% } %>

  <% if (errors) { %>
    <ul class="errors">
      <% errors.forEach(e => { %><li><%= e.msg %></li><% }) %>
    </ul>
  <% } %>

  <form method="post" action="/inv/add-inventory">
    <label>Classification</label>
    <%- classificationList %>

    <label>Make</label>
    <input name="inv_make" required value="<%= inv_make || '' %>">

    <label>Model</label>
    <input name="inv_model" required value="<%= inv_model || '' %>">

    <label>Year</label>
    <input name="inv_year" type="number" min="1886" max="2099" required value="<%= inv_year || '' %>">

    <label>Description</label>
    <textarea name="inv_description" required><%= inv_description || '' %></textarea>

    <label>Image Path</label>
    <input name="inv_image" required value="<%= inv_image || '/images/vehicles/no-image.png' %>">

    <label>Thumbnail Path</label>
    <input name="inv_thumbnail" required value="<%= inv_thumbnail || '/images/vehicles/no-image-tn.png' %>">

    <label>Price</label>
    <input name="inv_price" type="number" step="0.01" min="0" required value="<%= inv_price || '' %>">

    <label>Miles</label>
    <input name="inv_miles" type="number" min="0" required value="<%= inv_miles || '' %>">

    <label>Color</label>
    <input name="inv_color" required value="<%= inv_color || '' %>">

    <button type="submit">Add Inventory</button>
  </form>
</main>

<%- include("../partials/footer") %>