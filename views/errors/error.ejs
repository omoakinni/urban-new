<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head', {title: title}) %>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .error-container {
            text-align: center;
            padding: 3rem 1rem;
            max-width: 800px;
            margin: 0 auto;
        }
        
        .error-code {
            font-size: 6rem;
            color: #dc3545;
            font-weight: bold;
            margin-bottom: 1rem;
        }
        
        .error-message {
            font-size: 1.5rem;
            color: #666;
            margin-bottom: 2rem;
        }
        
        .error-actions {
            margin-top: 2rem;
        }
        
        .btn-home {
            display: inline-block;
            padding: 0.75rem 1.5rem;
            background-color: #007bff;
            color: white;
            text-decoration: none;
            border-radius: 5px;
            font-size: 1.1rem;
        }
        
        .btn-home:hover {
            background-color: #0056b3;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <%- include('../partials/header') %>
    <%- include('../partials/nav', {nav}) %>
    
    <main class="container">
        <div class="error-container">
            <div class="error-code"><%= title %></div>
            <div class="error-message"><%= message %></div>
            <div class="error-actions">
                <a href="/" class="btn-home">Return to Homepage</a>
            </div>
        </div>
    </main>
    
    <%- include('../partials/footer') %>
</body>
</html>